# ==========================================
# MIBx Dispatch v3 - Environment Configuration
# ==========================================

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Supabase (PostgreSQL & Auth)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Shopify Partner App Credentials (Server-side ONLY)
SHOPIFY_API_KEY="your_shopify_client_id"
SHOPIFY_API_SECRET="your_shopify_client_secret"
SHOPIFY_APP_URL="http://localhost:3000"
SHOPIFY_SCOPES="read_orders,write_orders,read_fulfillments,write_fulfillments,read_products,read_customers,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders"
SHOPIFY_WEBHOOK_SECRET="your_shopify_webhook_signing_secret"

# Pathao Courier API Credentials (Server-side ONLY)
PATHAO_BASE_URL="https://api-hermes.pathao.com"
PATHAO_CLIENT_ID="your_pathao_client_id"
PATHAO_CLIENT_SECRET="your_pathao_client_secret"
PATHAO_USERNAME="your_pathao_account_email@domain.com"
PATHAO_PASSWORD="your_pathao_account_password"
PATHAO_WEBHOOK_SECRET="your_pathao_webhook_token"
